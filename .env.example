# Entra tenant
ENTRA_TENANT_ID=662f928d-ee5c-4b0a-a0f7-0072c9c0d1bd

# Entra App 1: Agentic Products (web client + API resource)
ENTRA_APP1_CLIENT_ID=
ENTRA_APP1_CLIENT_SECRET=
ENTRA_APP1_SCOPE=api://YOUR-APP1-CLIENT-ID/access_as_user
APP1_REDIRECT_URI=http://localhost:8001/auth/callback
APP1_BASE_URL=http://localhost:8001
# Separate local Agentic Products SAML SP; its Enterprise app is distinct from this OAuth/OBO app registration.
APP1_SAML_SP_ENTITY_ID=http://localhost:8001/saml/metadata
APP1_SAML_ACS_URL=http://localhost:8001/saml/acs
APP1_SAML_IDP_METADATA_URL=

# Entra App 2: Factory OBO API
ENTRA_APP2_CLIENT_ID=
ENTRA_APP2_CLIENT_SECRET=
ENTRA_APP2_SCOPE=api://YOUR-APP2-CLIENT-ID/access_as_user
APP2_BASE_URL=http://localhost:8002
APP2_OAUTH_REDIRECT_URI=http://localhost:8002/auth/callback

# Local Factory SAML service provider (separate from Factory's hosted WorkOS SSO)
SAML_SP_ENTITY_ID=http://localhost:8002/saml/metadata
SAML_ACS_URL=http://localhost:8002/saml/acs
# App Federation Metadata Url from the local Factory SAML Enterprise application.
SAML_IDP_METADATA_URL=

# GitHub App (created under your personal GitHub account)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8002/github/callback
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem

# Generate with:
# uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
TOKEN_DATABASE_PATH=./local_tokens.sqlite3
